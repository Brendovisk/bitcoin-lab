# API
PORT=3001

# Mainnet Bitcoin Core (read-only)
MAINNET_RPC_HOST=127.0.0.1
MAINNET_RPC_PORT=8332
MAINNET_RPC_USER=dev
MAINNET_RPC_PASS=devpass

# Regtest Bitcoin Core (read + write)
REGTEST_RPC_HOST=127.0.0.1
REGTEST_RPC_PORT=18443
REGTEST_RPC_USER=dev
REGTEST_RPC_PASS=devpass

# ZMQ (mainnet)
ZMQ_HASHBLOCK_URL=tcp://127.0.0.1:28332
ZMQ_HASHTX_URL=tcp://127.0.0.1:28333

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:3000
